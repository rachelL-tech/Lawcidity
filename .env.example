# RDS PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_RDS_PASSWORD@YOUR_RDS_ENDPOINT:5432/citations

# OpenSearch
# 給容器內 app / scripts 使用（docker compose 內請用 service 名稱）
OPENSEARCH_URL=http://opensearch:9200
# 給 EC2 手動 curl 排查使用
OPENSEARCH_HOST_URL=http://localhost:9200

EMBED_BACKEND=cf
CF_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CF_AI_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# AI services
VOYAGE_API_KEY=YOUR_VOYAGE_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 搜尋後端：未設定時走 OpenSearch；小資料集部署（Vercel + Neon）設為 postgres
# SEARCH_BACKEND=postgres

# retrieval trace 寫入路徑；serverless 的檔案系統唯讀，需改到 /tmp
# TRACES_PATH=/tmp/traces.jsonl

# AI endpoint（/api/analyze、/api/analyze/generate）每日次數上限；都不設定則不啟用
# RATE_LIMIT_PER_IP_DAILY=20
# RATE_LIMIT_GLOBAL_DAILY=300
